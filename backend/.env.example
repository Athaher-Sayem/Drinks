# Use `python -m app.cli init-env` to generate a persistent random local secret.
STORE_ENVIRONMENT=development
STORE_SECRET_KEY=
STORE_DATABASE_URL=sqlite:///./store.db
# Production: postgresql+psycopg://user:URL-encoded-password@host:5432/store?sslmode=require
# These settings are JSON arrays, not comma-separated strings.
STORE_ALLOWED_ORIGINS=["http://localhost:5173"]
STORE_ALLOWED_HOSTS=["localhost","127.0.0.1"]
STORE_COOKIE_NAME=store_session
STORE_SESSION_DAYS=14
